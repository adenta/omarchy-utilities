#!/bin/bash
# Compare installed stock background code with the explicitly reviewed baseline.
set -euo pipefail

if [[ ${1:-} == --notify ]]; then
  shift
  if result=$(timeout 2s bash "$0" "$@"); then
    case $result in
      current) exit 0 ;;
      changed)
        headline="Custom background needs review"
        body="Omarchy’s stock background code changed. Review your custom background for updates."
        ;;
      *) result=unknown ;;
    esac
  else
    result=unknown
  fi
  if [[ $result == unknown ]]; then
    headline="Background update check failed"
    body="Could not verify whether your custom background is up to date with installed Omarchy."
  fi
  if ! omarchy notification send -u normal "$headline" "$body"; then
    echo "omarchy background: upstream notification delivery failed" >&2
    exit 1
  fi
  exit 0
fi

source_dir=${1:-/usr/share/omarchy/shell/plugins/background}
baseline=${2:-$(dirname "$0")/upstream.sha256}
[[ -d $source_dir && -f $baseline ]] || exit 1
current=$(
  cd "$source_dir"
  find . -type f -print0 | LC_ALL=C sort -z | xargs -0 -r sha256sum | sha256sum | cut -d ' ' -f 1
)
expected=$(cat "$baseline")
[[ $expected =~ ^[0-9a-f]{64}$ ]] || exit 1
if [[ $current == "$expected" ]]; then echo current; else echo changed; fi
