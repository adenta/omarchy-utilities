#!/usr/bin/env bash
# Source: https://github.com/adenta/omarchy-utilities
set -euo pipefail
api_key=$(secret-tool lookup application codex-tasks provider openrouter) || exit 3
test -n "$api_key" || exit 3
printf 'header = "Authorization: Bearer %s"\n' "$api_key" |
  curl --config - --silent --show-error --fail --connect-timeout 10 --max-time 30 \
    https://openrouter.ai/api/v1/key |
  jq -er 'if (.data | has("limit_remaining")) then
    if .data.limit_remaining == null then "unlimited"
    elif (.data.limit_remaining | type) == "number" and .data.limit_remaining >= 0 then .data.limit_remaining
    else error("Invalid balance") end
    else error("Missing balance") end'
