#!/bin/bash
# Source: https://github.com/adenta/omarchy-utilities — read AGENTS.md; update XPS and Grace.
# Derived from Omarchy 4.0.3-1 bin/omarchy-screensaver (48 lines).
# MIT, Copyright (c) David Heinemeier Hansson; see licenses/Omarchy-MIT.txt.
# Local changes: immutable artwork input, three completed effects per Pokémon,
# viewport-sized canvas, entrance selection, no adjacent repeats, and child cleanup.
# The installed ttfx remains the renderer.

artwork=${1:?Usage: render ARTWORK_PATH}
effect_pid=""

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  local status=${1:-0}
  trap - SIGINT SIGTERM SIGHUP SIGQUIT
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  if [[ -n $effect_pid ]]; then
    kill "$effect_pid" 2>/dev/null
    wait "$effect_pid" 2>/dev/null
  fi
  pkill -x ttfx 2>/dev/null
  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null
  exit "$status"
}

# Exit the screensaver on signals and input from keyboard and mouse.
trap 'exit_screensaver 0' SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'  # Set background color to black
hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

# Terminals initially allocate an 80x24 pty before the compositor resizes it.
wait_for_terminal_resize() {
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
    sleep 0.02
  done
}

wait_for_terminal_resize

completed=0
previous_effect=""
# Audited against ttfx 0.3.2 with Pokémon artwork. These 26 effects start
# without the recognizable picture; some use particles rather than darkness.
entrance_effects=(
  beams binarypath blackhole bouncyballs bubbles decrypt expand fireworks
  laseretch matrix middleout orbittingvolley overflow pour print rain
  randomsequence scattered slice slide spray swarm sweep synthgrid waves wipe
)
# These start with the picture already visible, possibly dimmed or distorted.
# Rings remains excluded from every cycle.
visible_effects=(
  burn colorshift crumble errorcorrect highlight smoke spotlights thunderstorm
  unstable vhstape
)

while true; do
  effects=("${entrance_effects[@]}")
  (( completed > 0 )) && effects+=("${visible_effects[@]}")
  candidates=()
  for candidate in "${effects[@]}"; do
    [[ $candidate == "$previous_effect" ]] || candidates+=("$candidate")
  done
  effect=$(shuf -n 1 -e "${candidates[@]}") || exit_screensaver 1

  # Zero dimensions use the real terminal, including its bottom effect row.
  # Ignore inherited size overrides; never enlarge the canvas for centering.
  env -u COLUMNS -u LINES ttfx -i "$artwork" \
    --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
    --no-eol --no-restore-cursor "$effect" &
  effect_pid=$!

  while kill -0 "$effect_pid" 2>/dev/null; do
    if read -r -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
  wait "$effect_pid"
  status=$?
  effect_pid=""
  (( status == 0 )) || exit_screensaver "$status"
  # Keep this across Pokémon changes, so a group boundary cannot repeat it.
  previous_effect=$effect

  ((completed += 1))
  if (( completed == 3 )); then
    artwork=$("$HOME/.local/bin/omarchy-pokemon-select" --path) || exit_screensaver 1
    completed=0
  fi
done
