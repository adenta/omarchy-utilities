#!/bin/bash
# Source: https://github.com/adenta/omarchy-utilities — read AGENTS.md; update XPS and Grace.
# Derived from Omarchy 4.0.3-1 bin/omarchy-screensaver (48 lines).
# MIT, Copyright (c) David Heinemeier Hansson; see licenses/Omarchy-MIT.txt.
# Local changes: immutable artwork input, three completed effects per Pokémon,
# centered canvas sizing, and child-PID waiting/error cleanup.
# The installed ttfx remains the renderer.

artwork=${1:?Usage: render ARTWORK_PATH}
effect_pid=""

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  local status=${1:-0}
  trap - SIGINT SIGTERM SIGHUP SIGQUIT
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  if [[ -n $effect_pid ]]; then
    kill "$effect_pid" 2>/dev/null
    wait "$effect_pid" 2>/dev/null
  fi
  pkill -x ttfx 2>/dev/null
  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null
  exit "$status"
}

# Exit the screensaver on signals and input from keyboard and mouse.
trap 'exit_screensaver 0' SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'  # Set background color to black
hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

# Terminals initially allocate an 80x24 pty before the compositor resizes it.
wait_for_terminal_resize() {
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
    sleep 0.02
  done
}

wait_for_terminal_resize

completed=0
while true; do
  # ttfx 0.3.2 biases centered text upward on odd-height canvases. Round the
  # canvas up to an even height; terminal clipping hides the extra bottom row
  # while preserving every visible row. Re-measure before each effect.
  read -r terminal_rows terminal_columns < <(stty size) || exit_screensaver 1
  [[ $terminal_rows =~ ^[1-9][0-9]*$ ]] || exit_screensaver 1
  canvas_height=$((terminal_rows + terminal_rows % 2))

  ttfx -i "$artwork" \
    --frame-rate 120 --canvas-width 0 --canvas-height "$canvas_height" --reuse-canvas --anchor-canvas c --anchor-text c \
    --random-effect --no-eol --no-restore-cursor &
  effect_pid=$!

  while kill -0 "$effect_pid" 2>/dev/null; do
    if read -r -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
  wait "$effect_pid"
  status=$?
  effect_pid=""
  (( status == 0 )) || exit_screensaver "$status"

  ((completed += 1))
  if (( completed == 3 )); then
    artwork=$("$HOME/.local/bin/omarchy-pokemon-select" --path) || exit_screensaver 1
    completed=0
  fi
done
