{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "id": "andre.bar",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "h:mm:ss AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "andre.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "andre.system-pulse"
        },
        {
          "id": "andre.backups"
        },
        {
          "id": "andre.credits"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "adenta.codex-ops"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": false
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "cloneSourceRestores": [
    "andre.idle",
    "andre.background"
  ],
  "disabledPlugins": [
    "omarchy.idle",
    "omarchy.background"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "andre.idle"
    },
    {
      "id": "andre.background"
    }
  ],
  "version": 1
}
